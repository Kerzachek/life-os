<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет LifeOS (LifeOsGlanceWidget): только классы, разрешённые в RemoteViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lifeos_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_safe_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Доступно сегодня"
                android:textColor="#FF8B949E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_safe_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Откройте LifeOS"
                android:textColor="#FFF0F6FC"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/lifeos_widget_button"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="Открыть"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Задачи на сегодня"
        android:textColor="#FF8B949E"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_task1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFF0F6FC"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_task2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFF0F6FC"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_tasks_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textColor="#FF00B894"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_routine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#FF00CEC9"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
